# Local Docker credentials for disposable, fictional S0/S1/S2 data only.
DATABASE_URL=postgresql://kaida:kaida_local@127.0.0.1:5432/kaida
TEST_DATABASE_URL=postgresql://kaida:kaida_local@127.0.0.1:5432/kaida_test
# Technical S1 default only; not an approved product policy.
OFFER_VALIDITY_PERIOD_HOURS=168
# S11 server-side Nearby policy. Buyer clients cannot override this radius.
NEARBY_RADIUS_METERS=5000
# Technical S2 defaults only; not approved product policy.
IDENTITY_OTP_TTL_SECONDS=300
IDENTITY_SESSION_TTL_SECONDS=2592000
# Required. Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IDENTITY_OTP_HMAC_SECRET_HEX=replace_with_64_hex_characters
# Local HTTP development only. Public HTTPS deployment must use true.
IDENTITY_COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1
# Seller comment translation. off (default): every comment is shown as written. fake: deterministic in-process
# stand-in for tests and demos. A real LLM adapter needs a KAIDA-hosted model or a Product Owner approved provider.
SELLER_COMMENT_TRANSLATOR=off
# operator-post-check: login phones of KAIDA operators (comma-separated, +7XXXXXXXXXX). Empty: nobody is an operator.
OPERATOR_PHONES=
# offer-actuality (hours since the Seller's last confirmation): the task / first reminder, the ageing tier and the
# archive. OFFER_VALIDITY_PERIOD_HOURS above is the moment an offer is hidden from buyers.
ACTUALITY_DUE_HOURS=24
ACTUALITY_AGEING_HOURS=48
ACTUALITY_ARCHIVE_HOURS=336
# actuality-reminders: two reminder moments (hours since confirmation): the day before dropping and before hiding.
ACTUALITY_REMINDER_HOURS=24,144
# Browser push (VAPID). Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Empty: push is off — no button, no reminder job; the in-app block still reminds.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.kz
# Protects POST /api/internal/actuality-reminders/run (manual or external cron start). Empty: the endpoint is off.
INTERNAL_JOB_SECRET=
