# R3 reference stack environment (docs/ops/DEPLOYMENT.md). Copy to a file OUTSIDE the repository, fill in, never commit.
# Every value below is a placeholder; real secrets exist only in your copy.

# --- Database (names must not be kaida / kaida_test; password: 16+ letters or digits) ---
KAIDA_DB_USER=kaida_deploy
KAIDA_DB_PASSWORD=
KAIDA_DB_NAME=kaida_deploy

# --- Authentication ---
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IDENTITY_OTP_HMAC_SECRET_HEX=
# The stack is served over HTTPS: must be true.
IDENTITY_COOKIE_SECURE=true

# Photos live in the named volume kaida-deploy-check_photos. See the R2 staging procedure in the runbook.

# --- Access. Default: loopback only. A private address needs KAIDA_PRIVATE_TEST_ACK=yes and means PRIVATE TESTING ONLY ---
# (Test OTP returns the login code to the client: anyone who can reach the stack can log in as any phone.)
KAIDA_BIND_ADDRESS=127.0.0.1
KAIDA_APP_PORT=3400
KAIDA_PRIVATE_TEST_ACK=
# Only for the TLS acceptance proxy (docker-compose.tls-check.yml)
KAIDA_TLS_PORT=8443

# --- Application ---
# Comma-separated +7XXXXXXXXXX; empty: nobody is an operator.
OPERATOR_PHONES=
# dev | test. organic is REFUSED by the preflight until the daily purge is scheduled and verified (O-D0-ORG).
SEARCH_EVENTS_ORIGIN=dev
# off (default): comments are shown as written.
SELLER_COMMENT_TRANSLATOR=off
# Optional browser push (all three, or none)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Optional: protects POST /api/internal/actuality-reminders/run
INTERNAL_JOB_SECRET=
